<?xml version="1.0" encoding="UTF-8"?>
<smm:Application xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:smm="smm"
    xsi:schemaLocation="smm smm.ecore"
    name="LibraryApp"
    basePackage="com.spring.app"
    javaVersion="21"
    serverPort="8080">

  <modules name="Library">

    <entities name="Book">
      <idType xsi:type="smm:PrimitiveType" kind="UUID"/>
      <attributes name="id" isId="true" isNullable="false">
        <type xsi:type="smm:PrimitiveType" kind="UUID"/>
      </attributes>
      <attributes name="title" isId="false" isNullable="false">
        <type xsi:type="smm:PrimitiveType" kind="STRING"/>
      </attributes>
    </entities>

    <repositories name="BookRepository"
        entityType="//@modules.0/@entities.0">
      <idType xsi:type="smm:PrimitiveType" kind="UUID"/>
      <methods name="findAll">
        <returnType xsi:type="smm:CollectionType" collection="LIST">
          <innerType xsi:type="smm:CustomType"
              reference="//@modules.0/@entities.0"/>
        </returnType>
      </methods>
    </repositories>

    <services name="LibraryService"
        requiredRepositories="//@modules.0/@repositories.0"/>

    <controllers name="BookController" basePath="/api/books"
        service="//@modules.0/@services.0">
      <endpoints name="getBooks" httpMethod="GET" path="/">
        <returnType xsi:type="smm:CollectionType" collection="LIST">
          <innerType xsi:type="smm:CustomType"
              reference="//@modules.0/@entities.0"/>
        </returnType>
      </endpoints>
    </controllers>

    <dtos name="BookDto"/>

  </modules>

</smm:Application>
